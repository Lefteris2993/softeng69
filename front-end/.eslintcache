[{"/home/aggeliki/softeng69/front-end/src/index.js":"1","/home/aggeliki/softeng69/front-end/src/App.js":"2","/home/aggeliki/softeng69/front-end/src/components/navbarmain/navbarmain.js":"3","/home/aggeliki/softeng69/front-end/src/components/navbarmain/MenuItems.js":"4","/home/aggeliki/softeng69/front-end/src/components/logoutbutton/logoutbutton.js":"5","/home/aggeliki/softeng69/front-end/src/components/login/login.js":"6","/home/aggeliki/softeng69/front-end/src/components/charge/charge.js":"7","/home/aggeliki/softeng69/front-end/src/components/startheader/startheader.js":"8","/home/aggeliki/softeng69/front-end/src/api.js":"9","/home/aggeliki/softeng69/front-end/src/config.js":"10"},{"size":198,"mtime":1608747782315,"results":"11","hashOfConfig":"12"},{"size":518,"mtime":1609339039162,"results":"13","hashOfConfig":"12"},{"size":1358,"mtime":1609016164282,"results":"14","hashOfConfig":"12"},{"size":477,"mtime":1609014511350,"results":"15","hashOfConfig":"12"},{"size":609,"mtime":1609013181270,"results":"16","hashOfConfig":"12"},{"size":3527,"mtime":1609087991285,"results":"17","hashOfConfig":"12"},{"size":208,"mtime":1609015970878,"results":"18","hashOfConfig":"12"},{"size":432,"mtime":1609078016888,"results":"19","hashOfConfig":"12"},{"size":319,"mtime":1609088418453,"results":"20","hashOfConfig":"12"},{"size":130,"mtime":1609086896593,"results":"21","hashOfConfig":"12"},{"filePath":"22","messages":"23","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"24"},"a7k7ed",{"filePath":"25","messages":"26","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"27","messages":"28","errorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"29","usedDeprecatedRules":"24"},{"filePath":"30","messages":"31","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"24"},{"filePath":"32","messages":"33","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"24"},{"filePath":"34","messages":"35","errorCount":0,"warningCount":7,"fixableErrorCount":0,"fixableWarningCount":0,"source":"36","usedDeprecatedRules":"24"},{"filePath":"37","messages":"38","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"24"},{"filePath":"39","messages":"40","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"24"},{"filePath":"41","messages":"42","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"24"},{"filePath":"43","messages":"44","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"45"},"/home/aggeliki/softeng69/front-end/src/index.js",[],["46","47"],"/home/aggeliki/softeng69/front-end/src/App.js",["48"],"/home/aggeliki/softeng69/front-end/src/components/navbarmain/navbarmain.js",["49","50","51","52"],"import React from 'react';\nimport {\n    BrowserRouter as Router,\n    Switch,\n    Route\n} from \"react-router-dom\";\nimport { MenuItems } from \"./MenuItems\";\nimport { Logoutbutton } from \"../logoutbutton/logoutbutton\";\nimport Charge from \"../charge/charge\"\nimport './navbarmain.scss'\n\nclass NavbarMain extends React.Component {\n\n\n    render() {\n        return (\n\n            <nav className=\"NavbarItems\">\n                <h1 className=\"navbar-logo\"><i className=\"fas fa-plug\">  Eos</i></h1>\n                <ul className='nav-menu'>\n                    {MenuItems.map((item, index) => {\n                        return (\n                            <li key={index}>\n                                <a className={item.cName} href={item.url}>\n                                    {item.title}\n                                </a>\n                            </li>\n                        )\n                    })}\n                </ul>\n                <Logoutbutton>Logout</Logoutbutton>\n                {/* <Router>\n                    <div>\n                        <Switch>\n                            <Route path=\"/charge\">\n                                <Charge />\n                            </Route>\n                        </Switch>\n                    </div>\n                </Router> */}\n            </nav>\n\n\n        );\n    }\n}\n\nexport default NavbarMain;","/home/aggeliki/softeng69/front-end/src/components/navbarmain/MenuItems.js",[],"/home/aggeliki/softeng69/front-end/src/components/logoutbutton/logoutbutton.js",[],"/home/aggeliki/softeng69/front-end/src/components/login/login.js",["53","54","55","56","57","58","59"],"import React from \"react\";\nimport \"./login.scss\";\nimport { authenticateUser } from \"../../api\";\n\nclass Login extends React.Component {\n  constructor(props) {\n    super(props);\n    this.state = { username: '', password: '', token: null, autherror: null, errors: [] };\n    this.handleSubmit = this.handleSubmit.bind(this);\n    this.onUsernameChange = this.onUsernameChange.bind(this);\n    this.onPasswordChange = this.onPasswordChange.bind(this);\n  }\n\n  showValidationErr(elm, msg) {\n    this.setState((prevState) => ({\n      errors: [\n        ...prevState.errors, {\n          elm,\n          msg\n        }\n      ]\n    }));\n  }\n\n  clearValidationErr(elm) {\n    this.setState((prevState) => {\n      let newArr = [];\n\n      for (let err of prevState.errors) {\n        if (elm != err.elm) {\n          newArr.push(err);\n        }\n      }\n      return { errors: newArr };\n    });\n  }\n  onUsernameChange(event) {\n    this.setState({ username: event.target.value });\n    this.clearValidationErr(\"username\");\n  }\n\n  onPasswordChange(event) {\n    this.setState({ password: event.target.value });\n    this.clearValidationErr(\"password\");\n  }\n\n  handleSubmit(event) {\n    //make sure we got username and pswd\n    \n    if (this.state.username == \"\") {\n      this.showValidationErr(\"username\", \"Username Cannot be empty!\");\n    }\n    if (this.state.password == \"\") {\n      this.showValidationErr(\"password\", \"Password Cannot be empty!\");\n    }\n\n    //now send to backend\n    this.setState({ autherror: null });\n    if (this.state.password != \"\" && this.state.username != \"\") {\n      alert('A name was submitted: ' + this.state.username +this.state.password);\n      this.setState({ token: null });\n      let reqObj = {\n        username: this.state.username,\n        password: this.state.password\n      };\n      authenticateUser(reqObj)\n        .then(json => {\n          setTimeout(() => {\n            this.setState({ token: json.data.id });\n          }, 0);\n        })\n        .catch(err => {\n          this.setState({ autherror: err.error })\n        });\n    }\n    //event.preventDefault();\n  }\n\n  render() {\n\n    let usernameErr = null,\n      passwordErr = null;\n    //Loop and find which ones has the error\n    for (let err of this.state.errors) {\n      //Assign the validation error message \n      if (err.elm == \"username\") {\n        usernameErr = err.msg;\n      }\n      if (err.elm == \"password\") {\n        passwordErr = err.msg;\n      }\n    }\n\n    return (\n      <div className=\"Login\">\n        <div className=\"input-group\">\n          <label htmlFor=\"username\">Username</label>\n          <input\n            type=\"text\"\n            name=\"username\"\n            className=\"login-input\"\n            placeholder=\"Username\"\n            onChange={this\n              .onUsernameChange} />\n          <small className=\"danger-error\">{usernameErr\n            ? usernameErr\n            : \"\"}\n          </small>\n        </div>\n\n        <div className=\"input-group\">\n          <label htmlFor=\"password\">Password</label>\n          <input\n            type=\"password\"\n            name=\"password\"\n            className=\"login-input\"\n            placeholder=\"Password\"\n            onChange={this\n              .onPasswordChange} />\n          <small className=\"danger-error\">{passwordErr\n            ? passwordErr\n            : \"\"}\n          </small>\n        </div>\n\n        <button\n          type=\"button\"\n          className=\"login-btn\"\n          onClick={this\n            .handleSubmit}>Login</button>\n      </div>\n\n    );    \n  }\n}\n\nexport default Login;","/home/aggeliki/softeng69/front-end/src/components/charge/charge.js",[],"/home/aggeliki/softeng69/front-end/src/components/startheader/startheader.js",[],"/home/aggeliki/softeng69/front-end/src/api.js",[],"/home/aggeliki/softeng69/front-end/src/config.js",[],["60","61"],{"ruleId":"62","replacedBy":"63"},{"ruleId":"64","replacedBy":"65"},{"ruleId":"66","severity":1,"message":"67","line":4,"column":8,"nodeType":"68","messageId":"69","endLine":4,"endColumn":19},{"ruleId":"66","severity":1,"message":"70","line":3,"column":22,"nodeType":"68","messageId":"69","endLine":3,"endColumn":28},{"ruleId":"66","severity":1,"message":"71","line":4,"column":5,"nodeType":"68","messageId":"69","endLine":4,"endColumn":11},{"ruleId":"66","severity":1,"message":"72","line":5,"column":5,"nodeType":"68","messageId":"69","endLine":5,"endColumn":10},{"ruleId":"66","severity":1,"message":"73","line":9,"column":8,"nodeType":"68","messageId":"69","endLine":9,"endColumn":14},{"ruleId":"74","severity":1,"message":"75","line":30,"column":17,"nodeType":"76","messageId":"77","endLine":30,"endColumn":19},{"ruleId":"74","severity":1,"message":"78","line":50,"column":29,"nodeType":"76","messageId":"77","endLine":50,"endColumn":31},{"ruleId":"74","severity":1,"message":"78","line":53,"column":29,"nodeType":"76","messageId":"77","endLine":53,"endColumn":31},{"ruleId":"74","severity":1,"message":"75","line":59,"column":29,"nodeType":"76","messageId":"77","endLine":59,"endColumn":31},{"ruleId":"74","severity":1,"message":"75","line":59,"column":58,"nodeType":"76","